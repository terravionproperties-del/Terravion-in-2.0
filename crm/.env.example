# Microsoft SQL Server — the only database.
# SQLSERVER_DATABASE / SQLSERVER_USERNAME are also accepted for the two below.
SQLSERVER_HOST="localhost"
SQLSERVER_PORT="1433"
SQLSERVER_DB="TerravionCRM"
SQLSERVER_USER="terravion_app"
SQLSERVER_PASSWORD="change-me"
# Named instance instead of a port, e.g. "SQLEXPRESS". Leave blank if using a port.
SQLSERVER_INSTANCE=""
SQLSERVER_ENCRYPT="true"
# Only for a self-signed cert on a private network. Never true over the internet.
SQLSERVER_TRUST_CERT="true"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3100"

# Shared HMAC secret for POST /api/webhooks/lead.
# Must match LEAD_WEBHOOK_SECRET in the marketing site's environment.
LEAD_WEBHOOK_SECRET="replace-me-too"

# ── Seeding (npm run db:seed) ──────────────────────────────────────────
# Leave the password blank and one is generated and printed once. There is no
# default admin password on purpose.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""

# ── Notification delivery (npm run notify:worker) ──────────────────────
# None of these are set yet, so queued messages stay PENDING and the worker
# reports the channel as unconfigured. It never marks an undelivered message
# as sent.
#
# WhatsApp Business Cloud API — permanent token and phone number id.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE_LANG="en"
# SMTP — host, then add the transport in scripts/notify-worker.mjs.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# SMS gateway.
SMS_API_KEY=""
SMS_SENDER_ID=""