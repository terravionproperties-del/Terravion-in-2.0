# ─────────────────────────────────────────────────────────────────────────────
# Terravion GIS Platform — Environment Variables
# Copy to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Lead Capture (Critical for Production) ──────────────────────────────────
# Required in production. The site will refuse to start if either is missing,
# ensuring lead submissions are never silently lost.
#
# CRM_LEAD_ENDPOINT: Full URL to the CRM webhook endpoint receiving leads.
# Example: "https://crm.terravionproperties.in/api/webhooks/lead"
CRM_LEAD_ENDPOINT="https://your-crm-domain.com/api/webhooks/lead"

# LEAD_WEBHOOK_SECRET: Secret key (min 32 characters) for HMAC-SHA256 signature verification.
# Must match LEAD_WEBHOOK_SECRET in the CRM application environment.
LEAD_WEBHOOK_SECRET="your_32_character_minimum_webhook_secret_here"

# ── PostgreSQL (Hostinger / Supabase) ────────────────────────────────────────
# Hostinger PostgreSQL format:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# Supabase format (connection pooler):
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#
DATABASE_URL="postgresql://terravion_user:your_password@your-hostinger-host:5432/terravion_gis?sslmode=require"

# ── Supabase Realtime (optional — enables live inventory updates) ─────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ── GIS ───────────────────────────────────────────────────────────────────────
# No token is needed. The GIS surface is a canvas/3D visualisation of the
# sanctioned layout and its API is read-only, so there is nothing to authorise.
# GIS_ADMIN_TOKEN and NEXT_PUBLIC_GIS_ADMIN_TOKEN both existed here once and
# were removed as a security finding: the public one shipped the secret to
# every visitor's browser. Do not reintroduce either. If plot editing is ever
# required, put it behind an authenticated staff session in the CRM app.

# ── Admin surface ─────────────────────────────────────────────────────────────
# /admin is rewritten to 404 in production unless this is exactly "true".
# Leave unset until real staff authentication exists.
ADMIN_ENABLED=""

# ── Maps ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY="your_google_maps_api_key"
NEXT_PUBLIC_MAPBOX_TOKEN="your_mapbox_token"

# ── Analytics & measurement ──────────────────────────────────────────────────
# EVERY variable in this block is optional. Leave one blank and that single
# vendor's script is never rendered; nothing else changes and nothing breaks.
# All of them are read through lib/analytics.ts — never hardcode an ID in a
# component, or it follows a fork of this repo into someone else's property.
#
# Consent: Google Consent Mode v2 boots with analytics_storage and all three ad
# signals DENIED, per the DPDP Act 2023. components/analytics/ConsentBanner.tsx
# is the only thing that can change that, and Clarity is not loaded at all
# until a visitor accepts. Setting these IDs does not start tracking anyone.

# Google Analytics 4 — Admin → Data Streams → your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Tag Manager container. Optional and independent of GA4: you can run
# GA4 alone, GTM alone, or both. If you set this, tags you add in the GTM
# console must be configured there to respect Consent Mode — this codebase
# cannot gate what it cannot see.
NEXT_PUBLIC_GTM_ID=""

# Microsoft Clarity project id (Settings → Overview). Session replays and
# heatmaps, so it only ever loads after explicit consent.
NEXT_PUBLIC_CLARITY_ID=""

# Meta Pixel.
NEXT_PUBLIC_META_PIXEL_ID="your_pixel_id"

# ── Search console verification ──────────────────────────────────────────────
# Both optional, both server-side only (no NEXT_PUBLIC_ prefix) — they are
# rendered into <meta> tags by the root layout's generateMetadata and never
# reach the client bundle as variables. Leave blank if the property was
# verified by DNS TXT record instead, which is the sturdier method: an empty
# verification meta tag is a claim of ownership with no token behind it.

# Google Search Console → Add property → HTML tag. The content value only,
# not the whole <meta> element.
GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools → Verify → Meta tag. Rendered as msvalidate.01.
BING_SITE_VERIFICATION=""

# ── Cloudinary (media uploads) ────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://terravionproperties.com"

# ─────────────────────────────────────────────────────────────────────────────
# Hostinger Deployment Notes
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Create PostgreSQL database in Hostinger hPanel
# 2. Run migrations: DATABASE_URL="..." npx prisma migrate deploy
# 3. Seed plots: DATABASE_URL="..." npx ts-node scripts/seed-gis.ts
# 4. Build: npm run build
# 5. Deploy via Hostinger Node.js hosting or use:
#    - next start -p 3000
#    OR configure PM2:
#    - pm2 start npm --name "terravion" -- start
#
# Hostinger requires NODE_VERSION >= 18 in .node-version or .nvmrc
