{
  "name": "terravion-properties",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Terravion Properties — Premium HMDA & DTCP approved villa plots in Shankarpally, Hyderabad",
  "scripts": {
    "dev": "next dev --turbopack",
    "content": "node scripts/gen-content-index.mjs && node scripts/gen-translation-index.mjs",
    "prebuild": "node scripts/gen-content-index.mjs && node scripts/gen-translation-index.mjs && node scripts/check-locales.mjs",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "release:audit": "node scripts/release-audit.mjs",
    "film:build": "node scripts/build-film.ts build",
    "film:clean": "node scripts/build-film.ts clean",
    "film:verify": "node scripts/build-film.ts verify",
    "film:manifest": "node scripts/build-film.ts manifest",
    "i18n:check": "node scripts/check-locales.mjs",
    "i18n:index": "node scripts/gen-translation-index.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:parity": "node scripts/i18n-parity.mjs",
    "i18n:progress": "node scripts/i18n-progress.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/geojson": "^7946.0.16",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "maplibre-gl": "^6.3.0",
    "marked": "^18.0.9",
    "next": "^15.5.22",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-map-gl": "^8.1.2",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
